# Pathfinder - Learning Path Recommender
# Environment Variables Configuration Template

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================

# Google Gemini API Key for the AI Assistant feature.
# Get a key from: https://aistudio.google.com/
# If this is missing or empty, the backend will automatically fallback 
# to a deterministic fallback engine for the conversational assistant.
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database connection string. 
# Optional: Defaults to sqlite:///./learning_recommender.db if not provided.
DATABASE_URL=sqlite:///./learning_recommender.db

# ==========================================
# Frontend Configuration (Vite/React)
# ==========================================

# Base URL for the FastAPI backend.
# Optional: Defaults to http://127.0.0.1:8000/api if not provided.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
